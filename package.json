{
  "name": "gogreen",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "GoGreen: o melhor jeito de se locomover pela cidade, com informações dos próprios moradores.",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/baixar-consumo.mjs && node scripts/baixar-pontos.mjs && node scripts/baixar-enderecos.mjs && vite build",
    "preview": "vite preview",
    "test": "node --test \"tests/unit/*.test.js\" \"tests/database/*.test.js\"",
    "test:e2e": "node tests/e2e/rotas-unica-tela.cjs && node tests/e2e/onibus-estimativa.cjs",
    "build:app": "vite build",
    "lint": "eslint .",
    "test:tudo": "npm run lint && npm test && npm run test:e2e",
    "db:migrar": "node --env-file=.env.local scripts/migrar.mjs"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.2.0",
    "@noorddev/vlak": "0.5.0",
    "fflate": "^0.8.3",
    "leaflet": "^1.9.4"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.15",
    "eslint": "^9.39.5",
    "globals": "^15.15.0",
    "pdfjs-dist": "^4.0.379",
    "playwright": "^1.65.0",
    "vite": "^6.4.5"
  }
}
